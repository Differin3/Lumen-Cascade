; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lumen Cascade"
config/version="0.0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.05, 0.05, 1)
boot_splash/image="res://assets/studio_logo.png"
config/icon="res://assets/logo_Lumen Cascade.png"
boot_splash/minimum_display_time=2.0

[autoload]

AudioManager="*res://scripts/AudioManager.gd"
RemoteConfig="res://scripts/remote_config.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/initial_position_type=0
window/stretch/mode="viewport"

